generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ShortenUrl {
  id        String        @id @default(uuid())
  url       String
  shortCode String        @unique
  count     AccessCount?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt()

  @@map("shorten_urls")
}

model AccessCount {
  id     String     @id @default(uuid())
  count  Int        @default(0)
  url_id String     @unique
  url    ShortenUrl @relation(fields: [url_id], references: [id], onDelete: Cascade)
}
